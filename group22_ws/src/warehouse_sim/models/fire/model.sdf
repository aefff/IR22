<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="fire_hazard">
    <static>true</static>
    <link name="source">
      <visual name="thermal_surface">
        <pose>0 0 0.3 0 0 0</pose>
        <geometry>
          <cone>
            <radius>0.25</radius>
            <length>0.6</length>
          </cone>
        </geometry>
        <material>
          <ambient>1 0.2 0 1</ambient>
          <diffuse>1 0.2 0 1</diffuse>
          <emissive>0.8 0.1 0 1</emissive>
        </material>
        <plugin filename="gz-sim-thermal-system"
                name="gz::sim::systems::Thermal">
          <temperature>@INITIAL_TEMPERATURE_K@</temperature>
        </plugin>
      </visual>
    </link>
  </model>
</sdf>
